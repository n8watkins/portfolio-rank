{
  "name": "portfolio-rank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7678",
    "build": "next build",
    "start": "next start -p 7678",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false cloudflare-env.d.ts",
    "check:cf-types": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false --check cloudflare-env.d.ts",
    "test:e2e": "scripts/test-e2e.sh"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@opennextjs/cloudflare": "1.20.15",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "release-kit": "github:n8watkins/release-kit#v2.7.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.0",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
