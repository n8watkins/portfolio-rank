{
  "name": "portfolio-rank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7678",
    "build": "next build",
    "start": "next start -p 7678",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:worker": "opennextjs-cloudflare build && node scripts/assets-fingerprint.mjs",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false cloudflare-env.d.ts",
    "check:cf-types": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false --check cloudflare-env.d.ts",
    "test:e2e": "scripts/test-e2e.sh",
    "eval:rubric": "node scripts/eval-rubric.mjs",
    "docs:rubric": "node scripts/rubric-docs.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sentry/browser": "11.11.0",
    "@sentry/cloudflare": "11.11.0",
    "@sentry/core": "11.11.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "openskill": "5.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "release-kit": "github:n8watkins/release-kit#v2.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.8",
    "typescript": "^7.0.2",
    "undici": "8.12.3",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
