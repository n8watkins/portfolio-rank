{
  "$schema": "node_modules/wrangler/config-schema.json",
  // PortfolioRank as a Cloudflare Worker, built by OpenNext (`npm run deploy`,
  // see DEPLOY.md).
  "name": "portfolio-rank",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  // nodejs_compat is required by OpenNext; global_fetch_strictly_public keeps
  // the server's own fetches (GitHub, PageSpeed, inspected sites) on the public
  // internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served only at its custom domains; deploys keep them attached. The site is
  // portfoliorank.dev (SITE_URL below); www and the old address
  // portfoliorank.n8builds.dev stay attached only to redirect to it
  // (worker/canonical-host.ts).
  "workers_dev": false,
  "routes": [
    { "pattern": "portfoliorank.dev", "custom_domain": true },
    { "pattern": "www.portfoliorank.dev", "custom_domain": true },
    { "pattern": "portfoliorank.n8builds.dev", "custom_domain": true }
  ],
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    // The screenshots the pipeline captures (pipeline/capture.mjs uploads them;
    // the Worker serves them at /shots/..., worker/assets.ts). Locally
    // (`next dev`, `npm run preview`) the binding is an empty simulated bucket.
    { "binding": "SHOTS", "bucket_name": "portfolio-rank" },
    // ISR pages (OpenNext incremental cache).
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "portfolio-rank-opennext-cache" }
  ],
  // Deduplicates the background revalidations of ISR pages.
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // The revalidation queue renders pages again by calling the worker itself.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "portfolio-rank" },
    // Sign-in links go through the shared mailroom (n8watkins/mailroom), app
    // "portfoliorank": its caps there are 60 a day, 150 a month and 6 per
    // address a day, with sign-in links kept a share of the day.
    { "binding": "MAILROOM", "service": "mailroom", "entrypoint": "Mailroom", "props": { "app": "portfoliorank" } }
  ],
  // Email (grade reports, owner alerts) goes through Cloudflare Email Service
  // from EMAIL_FROM, an address on n8builds.dev, which is onboarded for
  // sending; every send passes the shared gate's caps (lib/email/gate.mjs).
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Workers AI: blog illustrations (Flux Schnell; Lucid Origin only when it
  // errors), only within the free daily allowance (lib/content/neurons.mjs).
  "ai": { "binding": "AI" },
  "vars": {
    // "production", or "staging" in env.staging below (worker/staging.ts).
    "SITE_ENV": "production",
    // Tavily credits PortfolioRank may use a month. Wren and PortfolioRank share one free
    // account of 1,000: 750 there, 200 here, 50 spare (lib/content/tavily-credits.mjs).
    "TAVILY_MONTHLY_CREDITS": "200",
    // Where pages link captures: our own domain, where the Worker serves the
    // bucket with long edge and browser caching (worker/assets.ts). The
    // bucket's r2.dev address is rate-limited, uncached and for the pipeline
    // only (its SHOTS_BASE_URL repository secret).
    "SHOTS_BASE_URL": "/shots",
    // The site's address (lib/site.ts): canonical URLs, the sitemap, email
    // links, the origin and Turnstile checks, and Auth.js's callback URL
    // (/api/auth/callback/github, auth.ts). Other hosts redirect here.
    "SITE_URL": "https://portfoliorank.dev",
    // Server errors go to Sentry (worker/sentry.ts). A DSN is public by design:
    // it only lets a sender add events to this one project.
    "SENTRY_DSN": "https://524f3d71051d8ad12f3dafce965d0ed4@o4507767562371072.ingest.us.sentry.io/4512375298523136",
    // The end-of-day run (worker/night.ts, AUTOMATION.md "End of day").
    // Ranking v2's AI comparisons run only when this is "true" (RANKING.md).
    "RANKING_V2": "false",
    // "true" re-grades 3.5 grades from an older rubric, lowest priority.
    "RUBRIC_REGRADE": "true",
    // Gemini requests a minute, for the whole run.
    "GEMINI_RPM": "8",
    // Sites the nightly checks re-capture (oldest first) to find redesigns.
    "NIGHTLY_REFRESH": "150",
    // The GitHub account allowed to use /api/admin/* and /admin/*, by its
    // numeric id (`gh api user --jq .id`; n8watkins), never by login, which
    // can be renamed and then taken by someone else (lib/admin.ts).
    "ADMIN_GITHUB_ID": "8055935",
    // GitHub accounts younger than this many days can sign in, like and keep
    // lists, but their votes don't count, their claims wait for a review and
    // they can't remove or hide a portfolio (lib/rater.ts accountTooNew).
    "MIN_GITHUB_ACCOUNT_AGE_DAYS": "30",
    // "Grade my portfolio" (lib/grader, AUTOMATION.md): its API and crons do
    // nothing until this is "true", which waits for the redesign's UI.
    "GRADER_ENABLED": "false",
    // The free tools (/tools, lib/tools, docs/TOOLS.md): their pages and
    // APIs answer 404 until this is "true"; staging tries them first.
    "TOOLS_ENABLED": "false",
    // Email sign-in (a one-time link beside GitHub, lib/signin): the option in
    // the sign-in dialog and its routes are off until this is "true" (decision D3).
    "EMAIL_SIGNIN_ENABLED": "false",
    // The blog newsletter on Kit (AUTOMATION.md "Newsletter"): the deploy-level
    // switch for the sign-up forms, their API and the newsletter's tick (on the
    // five-minute cron, no trigger of its own). Off in production: no form, no
    // status request from pages and no database read. Launching takes this set
    // to "true", the KIT_API_KEY secret and the owner's switch on
    // /admin/blog/newsletter (stored, off until turned on). KIT_BROADCAST_MODE:
    // a new post becomes a broadcast "send" (scheduled 10 minutes ahead) or a "draft".
    "NEWSLETTER_ENABLED": "false",
    "KIT_BROADCAST_MODE": "send",
    // Games, badges, claims, live stats and report downloads (lib/games):
    // every one of their routes answers 404 until this is "true", which
    // happens with the redesign.
    "GAMES_V2": "false",
    // The sender of every email (lib/email/gate.mjs).
    "EMAIL_FROM": "portfoliorank@n8builds.dev",
    // The content engine's kill switch (docs/CONTENT-ENGINE.md): "off",
    // "dry-run" (draft mode: drafts wait on /admin/blog for the owner to
    // publish or reject) or "publish"; only the owner sets publish. Draft
    // mode in production since 2026-11-11 (owner); staging stays "off".
    "CONTENT_MODE": "dry-run",
    // The most drafts a week the owner may choose on /admin/blog
    // (lib/content/automation.mjs; at most 4). The page can only go lower.
    "CONTENT_DRAFTS_PER_WEEK": "2",
    // Never pay for Workers AI (lib/content/neurons.mjs, docs/COSTS.md "Workers
    // AI"): at most 40 AI images a UTC day, and behind it at most 2,500
    // neurons (40 Schnell images are about 2,320) of PortfolioRank's 5,000
    // slice of the account's free 10,000; no hourly cap (the portfoliorank-ai
    // AI Gateway's 40 per 3600 s only bounds a burst). Each image is reserved
    // in the database before the call, which is the guard that keeps it
    // free; a value above 40 or 2,500 is rejected and turns Workers AI off.
    "MAX_AI_IMAGES_PER_DAY": "40",
    "AI_NEURON_CEILING": "2500",
    // The image library (pipeline/content/library-stage.mjs, worker/library.ts):
    // the UTC hour of the once-a-day automatic run on the "15 * * * *" cron
    // ("23": 23:15 UTC, 3:15 pm Pacific in winter, just before the image day
    // resets at 00:00 UTC; "off" for none), which makes whatever the owner's
    // "Make now" left of the day's 40; and the model: "schnell", or
    // "flux2dev" (2,400 neurons an image at 1024x576 and 16 steps, so one a day).
    "LIBRARY_RUN_HOUR_UTC": "23",
    "LIBRARY_MODEL": "schnell"
    // Optional, JSON: GEMINI_BUDGET (caps, reserve, batch; pipeline/budget.mjs),
    // GEMINI_DAILY_QUOTA, RANKING_BUDGET, RANKING_BATCHED_COUNTS, RANKING_AI_WEIGHT,
    // GRADER_CAPS (lib/grader/caps.mjs), TOOLS_CAPS (lib/tools/caps.mjs, can only lower them), EMAIL_CAPS (lib/email/gate.mjs).
    // Optional: TURNSTILE_SITE_KEY (the public key of the Turnstile widget the
    // pages render; the secret is TURNSTILE_SECRET_KEY).
  },
  // Secrets (`wrangler secret put <NAME>`, never in this file): AUTH_SECRET,
  // AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, TURSO_DATABASE_URL, TURSO_AUTH_TOKEN,
  // PSI_API_KEY, GEMINI_API_KEY (the end-of-day run and people's queued
  // grades), GITHUB_DISPATCH_TOKEN (starts the nightly checks and the
  // grader's captures on GitHub Actions; a fine-grained token for
  // n8watkins/portfolio-rank with Actions read and write only) and
  // TURNSTILE_SECRET_KEY (poll votes and grade requests; both Workers
  // refuse them without it) and OWNER_EMAIL (owner alerts go there, the
  // owner's verified address). See DEPLOY.md.
  // The end-of-day run: Cloudflare's clock instead of GitHub's schedule,
  // which starts jobs hours late. Cron Triggers run in UTC; 03:30 is 20:30
  // in Los Angeles under daylight time and 04:30 under standard time, and
  // the handler starts the run only from the one that is 20:30 there
  // (pipeline/budget.mjs nightCrons, isNightStart).
  // "15 * * * *" finishes people's grade requests that waited for Gemini 3.5
  // (pipeline/people.mjs; none exist until "grade my portfolio" ships).
  // "0 16 * * 1" is the weekly model watch, Mondays (worker/model-watch.ts).
  // "*/5 * * * *" is the grader's tick (worker/grader.ts): report emails,
  // captures that didn't start, requests waiting for a later day, cleanup;
  // it returns at once while GRADER_ENABLED is not "true".
  "triggers": { "crons": ["30 3 * * *", "30 4 * * *", "15 * * * *", "0 16 * * 1", "*/5 * * * *"] },
  // One instance a night ("night-<Pacific date>"), one step per batch; and
  // the owner's "Write a draft now", one instance a draft (worker/draft.ts).
  "workflows": [
    { "name": "portfolio-rank-night", "binding": "NIGHT", "class_name": "EndOfDayWorkflow" },
    { "name": "portfolio-rank-draft", "binding": "DRAFT", "class_name": "DraftWorkflow" }
  ],
  // Run next to the Turso database (aws-us-east-2): every request makes several
  // queries, so a Worker near the visitor would pay a cross-country round trip
  // for each. Static assets are still served from the edge.
  "placement": { "mode": "targeted", "region": "aws:us-east-2" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
  // Workers Cache (worker/edge-cache.ts): Cloudflare's cache sits in front of the
  // CachedPages entrypoint, so the public pages, sitemap, robots.txt and share image
  // cost no CPU time once cached, for visitors without PortfolioRank's own cookies.
  // The default entrypoint runs on every request and sends only those to CachedPages.
  // cross_version_cache: a deploy keeps the cached pages; the key carries a fingerprint
  // of the static files instead, so new CSS or JavaScript still starts fresh.
  "cache": { "enabled": false, "cross_version_cache": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedPages": { "type": "worker", "cache": { "enabled": true } }
  },
  // The staging site (DEPLOY.md "Staging"): the same code as the Worker
  // "portfolio-rank-staging" (`--env staging`) at its own address, with its
  // own Turso database (its TURSO_* secrets) and its own ISR cache bucket.
  // Wrangler does not inherit bindings, vars, routes or workflows into an
  // environment, so each is repeated here on purpose.
  // It never spends the production Gemini quota: no Cron Triggers, and no
  // GEMINI_API_KEY or GITHUB_DISPATCH_TOKEN secret, so a manual end-of-day run
  // skips. It reads the production screenshot bucket (the Worker only ever
  // reads SHOTS; captures are uploaded by the pipeline on GitHub Actions).
  "env": {
    "staging": {
      "workers_dev": false,
      // The old staging address stays attached only to redirect to SITE_URL
      // (worker/canonical-host.ts).
      "routes": [
        { "pattern": "staging.portfoliorank.dev", "custom_domain": true },
        { "pattern": "staging.portfoliorank.n8builds.dev", "custom_domain": true }
      ],
      "preview_urls": false,
      "r2_buckets": [
        { "binding": "SHOTS", "bucket_name": "portfolio-rank" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "portfolio-rank-staging-opennext-cache" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "portfolio-rank-staging" },
        // Staging's own small mailroom app (n8watkins/mailroom), so testing here never spends production's sign-in links.
        { "binding": "MAILROOM", "service": "mailroom", "entrypoint": "Mailroom", "props": { "app": "portfoliorank-staging" } }
      ],
      "send_email": [{ "name": "SEND_EMAIL" }],
      "ai": { "binding": "AI" },
      "vars": {
        // "staging": robots.txt disallows everything and every response says
        // noindex (worker/staging.ts); Sentry tags events "staging".
        "SITE_ENV": "staging",
        "TAVILY_MONTHLY_CREDITS": "200",
        "SHOTS_BASE_URL": "/shots",
        // The staging GitHub OAuth app's callback is
        // https://staging.portfoliorank.dev/api/auth/callback/github.
        "SITE_URL": "https://staging.portfoliorank.dev",
        "SENTRY_DSN": "https://524f3d71051d8ad12f3dafce965d0ed4@o4507767562371072.ingest.us.sentry.io/4512375298523136",
        // Staging runs the launch features ahead of production (the launch
        // walkthrough, 2026-11-11). It has no crons, so RANKING_V2 only
        // switches the leaderboard views; the boards come from
        // scripts/recompute-ratings.mjs run against the staging database.
        "RANKING_V2": "true",
        "RUBRIC_REGRADE": "false",
        "GEMINI_RPM": "8",
        "NIGHTLY_REFRESH": "150",
        "ADMIN_GITHUB_ID": "8055935",
        "MIN_GITHUB_ACCOUNT_AGE_DAYS": "30",
        // Without GITHUB_DISPATCH_TOKEN a grade stops after the free checks
        // ("unavailable"); DEPLOY.md "Staging" says how prep grades finish.
        "GRADER_ENABLED": "true",
        "TOOLS_ENABLED": "true",
        "EMAIL_SIGNIN_ENABLED": "true",
        // The newsletter runs on staging first, against the owner's one Kit
        // account: sign-ups land on the real list (Kit's double opt-in), and new
        // posts only ever become drafts marked [staging] (worker/newsletter.ts).
        "NEWSLETTER_ENABLED": "true",
        "KIT_BROADCAST_MODE": "draft",
        "GAMES_V2": "true",
        "EMAIL_FROM": "portfoliorank@n8builds.dev",
        // Staging's own, lower email caps (lib/email/gate.mjs): it sends from the
        // same address and account as production, so a day of testing here can
        // never use up production's day. Kinds left out keep their defaults,
        // capped by the day's total.
        "EMAIL_CAPS": "{\"day\":20,\"perRecipient\":3,\"kinds\":{\"grade-report\":12,\"report-link\":8,\"owner-alert\":5,\"signin\":10},\"reserve\":{\"grade-report\":5,\"owner-alert\":3,\"signin\":3}}",
        // Off until the owner approves Gemini spending again after the audits
        // (2026-11-13). The 2026-11-12 walkthrough of automatic publishing used
        // "publish". Off, staging's crons write no post whatever key it has.
        "CONTENT_MODE": "off",
        "CONTENT_DRAFTS_PER_WEEK": "2",
        // Staging never spends Workers AI: production's counter can't see
        // staging's database, and both share the account's free allowance.
        "MAX_AI_IMAGES_PER_DAY": "0",
        "AI_NEURON_CEILING": "0",
        "LIBRARY_RUN_HOUR_UTC": "off",
        "LIBRARY_MODEL": "schnell",
        // Low caps for staging's own Gemini key, when it has one (DEPLOY.md
        // "Staging"): a tenth of production's day, most stages off.
        "GEMINI_DAILY_QUOTA": "{\"gemini-3.5-flash-lite\":50,\"gemini-3.1-flash-lite\":50}",
        "GEMINI_BUDGET": "{\"reserve\":5,\"batch\":5,\"stages\":{\"grade_new\":{\"cap\":10},\"grade_changed\":{\"cap\":5},\"compare\":{\"cap\":15},\"content\":{\"cap\":5},\"library\":{\"cap\":0},\"regrade\":{\"cap\":0},\"experiment\":{\"cap\":0}}}",
        // "Write a draft now" on staging (lib/content/jobs.mjs draftNowPolicy).
        "STAGING_DRAFTS_PER_DAY": "1",
        // The only addresses staging may email (lib/email/gate.mjs); empty
        // until the owner adds theirs.
        "STAGING_EMAIL_TO": ""
      },
      // Production's jobs, so staging is a faithful test bed
      // (docs/audits/release-and-staging.md). Without a GEMINI_API_KEY on the
      // staging Worker every Gemini job skips (the end-of-day run logs why,
      // the people queue drains nothing); with staging's own key (never
      // production's) they run under the low GEMINI_DAILY_QUOTA and
      // GEMINI_BUDGET caps above. The grader's tick starts no captures
      // without GITHUB_DISPATCH_TOKEN, which staging never gets, and email
      // only reaches STAGING_EMAIL_TO (lib/email/gate.mjs).
      // To keep staging's CPU time low, the hourly jobs run every six hours and
      // the grader's tick every 30 minutes (worker/crons.ts maps them to the
      // same jobs); the nightly and weekly crons match production's.
      "triggers": { "crons": ["30 3 * * *", "30 4 * * *", "15 */6 * * *", "0 16 * * 1", "*/30 * * * *"] },
      // The same edge cache as production (worker/edge-cache.ts).
      "cache": { "enabled": false, "cross_version_cache": true },
      "exports": {
        "default": { "type": "worker", "cache": { "enabled": false } },
        "CachedPages": { "type": "worker", "cache": { "enabled": true } }
      },
      // Bound so the code and its types match production; nothing starts it.
      "workflows": [
        { "name": "portfolio-rank-night-staging", "binding": "NIGHT", "class_name": "EndOfDayWorkflow" },
        { "name": "portfolio-rank-draft-staging", "binding": "DRAFT", "class_name": "DraftWorkflow" }
      ]
    }
  }
}
